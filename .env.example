# ==============================================================================
# Railway Reservation System - Environment Variables Configuration Template
# Copy this file to .env and adjust values for local development or deployment.
# NEVER commit the actual .env file or real production credentials to Git.
# ==============================================================================

# Project Details
PROJECT_NAME="Railway Reservation System (DSA Core)"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./railway.db"
# Or PostgreSQL connection string for production / CI service:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/railway_test"

# Seat Hold TTL Configuration (in seconds, default 5 minutes = 300)
SEAT_HOLD_DURATION_SECONDS=300

# Custom DSA Parameters
PNR_HASH_INITIAL_CAPACITY=64
BLOOM_FILTER_EXPECTED_ELEMENTS=10000
BLOOM_FILTER_FP_PROB=0.01

# Frontend API Base URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
